{
  "name": "agent-sessions",
  "displayName": "Agent Sessions",
  "description": "Claude Code and Codex sessions in one sidebar: live status, worktree, subscription usage, one click to open, new sessions as tabs.",
  "version": "0.8.45",
  "publisher": "satsaa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Satsaa/agent-sessions"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "sessions",
    "agent"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Sessions are read from the Claude Code and Codex home directories, not from the workspace."
    }
  },
  "type": "module",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentSessionsHub",
          "title": "Agent Sessions",
          "icon": "resources/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agentSessionsPhone",
          "title": "Agent Sessions",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "agentSessionsHub": [
        {
          "id": "agentSessions.list",
          "name": "Sessions",
          "icon": "resources/icon.svg",
          "contextualTitle": "Agent Sessions"
        },
        {
          "id": "agentSessions.current",
          "name": "Current",
          "icon": "resources/icon.svg",
          "contextualTitle": "The active agent tab's tasks, answers and questions"
        },
        {
          "id": "agentSessions.worktrees",
          "name": "Worktrees",
          "icon": "resources/icon.svg",
          "contextualTitle": "Git worktrees and their agents",
          "visibility": "collapsed"
        },
        {
          "id": "agentSessions.usage",
          "type": "webview",
          "name": "Usage",
          "icon": "resources/icon.svg",
          "contextualTitle": "Subscription usage",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentSessions.list",
        "contents": "Loading sessions…",
        "when": "!agentSessions.loaded"
      },
      {
        "view": "agentSessions.list",
        "contents": "No sessions found under ~/.claude or ~/.codex.\n[New Claude session](command:agentSessions.newClaude)\n[New Codex session](command:agentSessions.newCodex)",
        "when": "agentSessions.loaded && !agentSessions.searching"
      }
    ],
    "commands": [
      {
        "command": "agentSessions.show",
        "title": "Show Sessions",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.newClaude",
        "title": "New Claude Session",
        "category": "Agent Sessions",
        "icon": {
          "light": "resources/toolbar/claude-light.svg",
          "dark": "resources/toolbar/claude-dark.svg"
        }
      },
      {
        "command": "agentSessions.newCodex",
        "title": "New Codex Session",
        "category": "Agent Sessions",
        "icon": {
          "light": "resources/toolbar/codex-light.svg",
          "dark": "resources/toolbar/codex-dark.svg"
        }
      },
      {
        "command": "agentSessions.search",
        "title": "Search Sessions",
        "category": "Agent Sessions",
        "icon": "$(search)"
      },
      {
        "command": "agentSessions.clearSearch",
        "title": "Clear Search",
        "category": "Agent Sessions",
        "icon": "$(search-stop)"
      },
      {
        "command": "agentSessions.refresh",
        "title": "Refresh",
        "category": "Agent Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSessions.refreshUsage",
        "title": "Refresh Usage",
        "category": "Agent Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "agentSessions.showArchived",
        "title": "Show Archived Sessions",
        "category": "Agent Sessions",
        "icon": "$(archive)"
      },
      {
        "command": "agentSessions.hideArchived",
        "title": "Hide Archived Sessions",
        "category": "Agent Sessions",
        "icon": "$(archive)"
      },
      {
        "command": "agentSessions.showSubagents",
        "title": "Show All Subagent Threads",
        "category": "Agent Sessions",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "agentSessions.hideSubagents",
        "title": "Show Recent Subagent Threads Only",
        "category": "Agent Sessions",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "agentSessions.scopeWorkspace",
        "title": "Show Only This Repository",
        "category": "Agent Sessions",
        "icon": "$(filter)"
      },
      {
        "command": "agentSessions.scopeAll",
        "title": "Show All Repositories",
        "category": "Agent Sessions",
        "icon": "$(filter-filled)"
      },
      {
        "command": "agentSessions.groupBy",
        "title": "Group Sessions By…",
        "category": "Agent Sessions",
        "icon": "$(list-tree)"
      },
      {
        "command": "agentSessions.activeSort",
        "title": "Sort Active Sessions By…",
        "category": "Agent Sessions",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "agentSessions.subagentLayout",
        "title": "Subagent Layout…",
        "category": "Agent Sessions",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "agentSessions.open",
        "title": "Open Session",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.openInTerminal",
        "title": "Resume in Terminal",
        "category": "Agent Sessions",
        "icon": "$(terminal)"
      },
      {
        "command": "agentSessions.copyResumeCommand",
        "title": "Copy Resume Command",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.revealTranscript",
        "title": "Open Transcript File",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.openFolder",
        "title": "Open Working Directory in New Window",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.archive",
        "title": "Archive",
        "category": "Agent Sessions",
        "icon": "$(archive)"
      },
      {
        "command": "agentSessions.unarchive",
        "title": "Unarchive",
        "category": "Agent Sessions",
        "icon": "$(inbox)"
      },
      {
        "command": "agentSessions.moveToCodex",
        "title": "Move to Codex",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.moveToClaude",
        "title": "Move to Claude",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.showWorktrees",
        "title": "Show Worktrees",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.worktree.openFolder",
        "title": "Open Worktree in New Window",
        "category": "Agent Sessions",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentSessions.worktree.openTerminal",
        "title": "Open Terminal in Worktree",
        "category": "Agent Sessions",
        "icon": "$(terminal)"
      },
      {
        "command": "agentSessions.worktree.copyPath",
        "title": "Copy Worktree Path",
        "category": "Agent Sessions",
        "icon": "$(copy)"
      },
      {
        "command": "agentSessions.worktree.newClaude",
        "title": "New Claude Session Here (Terminal)",
        "category": "Agent Sessions",
        "icon": "$(add)"
      },
      {
        "command": "agentSessions.worktree.newCodex",
        "title": "New Codex Session Here (Terminal)",
        "category": "Agent Sessions",
        "icon": "$(add)"
      },
      {
        "command": "agentSessions.closeCodex",
        "title": "Close Codex Session…",
        "category": "Agent Sessions",
        "icon": "$(close)"
      },
      {
        "command": "agentSessions.pin",
        "title": "Pin Session",
        "category": "Agent Sessions",
        "icon": "$(pin)"
      },
      {
        "command": "agentSessions.unpin",
        "title": "Unpin Session",
        "category": "Agent Sessions",
        "icon": "$(unpin)"
      },
      {
        "command": "agentSessions.moveToBacklog",
        "title": "Move to Backlog",
        "category": "Agent Sessions",
        "icon": "$(inbox)"
      },
      {
        "command": "agentSessions.removeFromBacklog",
        "title": "Remove from Backlog",
        "category": "Agent Sessions",
        "icon": "$(discard)"
      },
      {
        "command": "agentSessions.detach",
        "title": "Detach from Parent",
        "category": "Agent Sessions",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agentSessions.reattach",
        "title": "Reattach to Parent",
        "category": "Agent Sessions",
        "icon": "$(link)"
      },
      {
        "command": "agentSessions.worktree.delete",
        "title": "Delete Worktree",
        "category": "Agent Sessions",
        "icon": "$(trash)",
        "enablement": "!operationInProgress"
      },
      {
        "command": "agentSessions.openTranscript",
        "title": "Open Transcript",
        "category": "Agent Sessions",
        "icon": "$(book)"
      },
      {
        "command": "agentSessions.copyTranscript",
        "title": "Copy Transcript",
        "category": "Agent Sessions",
        "icon": "$(copy)"
      },
      {
        "command": "agentSessions.copyIdentifier",
        "title": "Copy Identifier",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.switchCodexAccount",
        "title": "Switch Codex Account",
        "category": "Agent Sessions",
        "icon": "$(account)"
      },
      {
        "command": "agentSessions.rename",
        "title": "Rename Session",
        "category": "Agent Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "agentSessions.reloadCodexPanel",
        "title": "Reload Codex Panel",
        "category": "Agent Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentSessions.back",
        "title": "Back to Sessions",
        "category": "Agent Sessions",
        "icon": "$(arrow-left)"
      },
      {
        "command": "agentSessions.rowActions",
        "title": "More Actions…",
        "category": "Agent Sessions",
        "icon": "$(ellipsis)"
      },
      {
        "command": "agentSessions.undo",
        "title": "Undo",
        "category": "Agent Sessions",
        "icon": "$(discard)",
        "enablement": "agentSessions.canUndo"
      },
      {
        "command": "agentSessions.redo",
        "title": "Redo",
        "category": "Agent Sessions",
        "icon": "$(redo)",
        "enablement": "agentSessions.canRedo"
      },
      {
        "command": "agentSessions.note.open",
        "title": "Open Task, Answer or Question",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.note.done",
        "title": "Mark Task Done",
        "category": "Agent Sessions",
        "icon": "$(check)"
      },
      {
        "command": "agentSessions.note.markRead",
        "title": "Mark Answer Read",
        "category": "Agent Sessions",
        "icon": "$(check)"
      },
      {
        "command": "agentSessions.note.answered",
        "title": "Mark Answered",
        "category": "Agent Sessions",
        "icon": "$(check)"
      },
      {
        "command": "agentSessions.note.stale",
        "title": "Mark Stale",
        "category": "Agent Sessions",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agentSessions.note.reopen",
        "title": "Reopen",
        "category": "Agent Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentSessions.note.remove",
        "title": "Remove from the List",
        "category": "Agent Sessions",
        "icon": "$(close)"
      },
      {
        "command": "agentSessions.notes.install",
        "title": "Install the Agent Sessions Plugin for Claude Code and Codex",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.notes.uninstall",
        "title": "Remove the Agent Sessions Plugin from Claude Code and Codex",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.note.editResolution",
        "title": "Edit Resolution…",
        "category": "Agent Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "agentSessions.note.viewDone",
        "title": "View Completion Record",
        "category": "Agent Sessions",
        "icon": "$(pass-filled)"
      },
      {
        "command": "agentSessions.note.editDone",
        "title": "Edit Completion Record…",
        "category": "Agent Sessions",
        "icon": "$(edit)"
      },
      {
        "command": "agentSessions.note.reopenSession",
        "title": "Reopen Session (Not Done)",
        "category": "Agent Sessions",
        "icon": "$(debug-restart)"
      },
      {
        "command": "agentSessions.notes.viewAnswers",
        "title": "View All Answers",
        "category": "Agent Sessions",
        "icon": "$(book)"
      },
      {
        "command": "agentSessions.notes.doneAll",
        "title": "Mark All Tasks Done",
        "category": "Agent Sessions",
        "icon": "$(check-all)"
      },
      {
        "command": "agentSessions.notes.markAllRead",
        "title": "Mark All Answers Read",
        "category": "Agent Sessions",
        "icon": "$(check-all)"
      },
      {
        "command": "agentSessions.notes.answerAll",
        "title": "Mark All Questions Answered",
        "category": "Agent Sessions",
        "icon": "$(check-all)"
      },
      {
        "command": "agentSessions.notes.staleAll",
        "title": "Mark All Stale",
        "category": "Agent Sessions",
        "icon": "$(circle-slash)"
      },
      {
        "command": "agentSessions.notes.removeClosed",
        "title": "Remove Closed from the List",
        "category": "Agent Sessions",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentSessions.back",
          "when": "agentSessions.phoneMode",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "agentSessions.search",
          "when": "view == agentSessions.list",
          "group": "navigation@0"
        },
        {
          "command": "agentSessions.clearSearch",
          "when": "view == agentSessions.list && agentSessions.searching",
          "group": "navigation@0"
        },
        {
          "command": "agentSessions.newClaude",
          "when": "view == agentSessions.list",
          "group": "navigation@1"
        },
        {
          "command": "agentSessions.newCodex",
          "when": "view == agentSessions.list",
          "group": "navigation@2"
        },
        {
          "command": "agentSessions.refresh",
          "when": "view == agentSessions.list",
          "group": "navigation@9"
        },
        {
          "command": "agentSessions.showArchived",
          "when": "view == agentSessions.list && !agentSessions.showArchived",
          "group": "1_filters@1"
        },
        {
          "command": "agentSessions.hideArchived",
          "when": "view == agentSessions.list && agentSessions.showArchived",
          "group": "1_filters@1"
        },
        {
          "command": "agentSessions.showSubagents",
          "when": "view == agentSessions.list && !agentSessions.showSubagents",
          "group": "1_filters@2"
        },
        {
          "command": "agentSessions.hideSubagents",
          "when": "view == agentSessions.list && agentSessions.showSubagents",
          "group": "1_filters@2"
        },
        {
          "command": "agentSessions.scopeWorkspace",
          "when": "view == agentSessions.list && agentSessions.scope == all",
          "group": "1_filters@3"
        },
        {
          "command": "agentSessions.scopeAll",
          "when": "view == agentSessions.list && agentSessions.scope == workspace",
          "group": "1_filters@3"
        },
        {
          "command": "agentSessions.groupBy",
          "when": "view == agentSessions.list",
          "group": "2_layout@1"
        },
        {
          "command": "agentSessions.activeSort",
          "when": "view == agentSessions.list",
          "group": "2_layout@2"
        },
        {
          "command": "agentSessions.subagentLayout",
          "when": "view == agentSessions.list",
          "group": "2_layout@3"
        },
        {
          "command": "agentSessions.refreshUsage",
          "when": "view == agentSessions.usage",
          "group": "navigation@1"
        },
        {
          "command": "agentSessions.refresh",
          "when": "view == agentSessions.worktrees",
          "group": "navigation"
        },
        {
          "command": "agentSessions.switchCodexAccount",
          "when": "view == agentSessions.usage",
          "group": "navigation@2"
        },
        {
          "command": "agentSessions.switchCodexAccount",
          "when": "view == agentSessions.list",
          "group": "3_accounts@1"
        },
        {
          "command": "agentSessions.undo",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/",
          "group": "0_history@1"
        },
        {
          "command": "agentSessions.redo",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/",
          "group": "0_history@2"
        }
      ],
      "view/item/context": [
        {
          "command": "agentSessions.openTranscript",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /subagent/ && view not in agentSessions.multiSelect",
          "group": "1_open@1"
        },
        {
          "command": "agentSessions.archive",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /archived/) && !(viewItem =~ /subagent/) && !agentSessions.phoneMode",
          "group": "inline@2"
        },
        {
          "command": "agentSessions.unarchive",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /archived/ && !agentSessions.phoneMode",
          "group": "inline@2"
        },
        {
          "command": "agentSessions.open",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /subagent/) && view not in agentSessions.multiSelect",
          "group": "1_open@1"
        },
        {
          "command": "agentSessions.openInTerminal",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /subagent/)",
          "group": "1_open@2"
        },
        {
          "command": "agentSessions.openFolder",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && view not in agentSessions.multiSelect",
          "group": "1_open@3"
        },
        {
          "command": "agentSessions.copyResumeCommand",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /subagent/)",
          "group": "2_copy@1"
        },
        {
          "command": "agentSessions.revealTranscript",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && view not in agentSessions.multiSelect",
          "group": "2_copy@2"
        },
        {
          "command": "agentSessions.archive",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /archived/) && !(viewItem =~ /subagent/)",
          "group": "3_archive@1"
        },
        {
          "command": "agentSessions.unarchive",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /archived/",
          "group": "3_archive@1"
        },
        {
          "command": "agentSessions.moveToCodex",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session-claude/ && !(viewItem =~ /subagent/) && view not in agentSessions.multiSelect",
          "group": "3_archive@2"
        },
        {
          "command": "agentSessions.moveToClaude",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session-codex/ && !(viewItem =~ /subagent/) && view not in agentSessions.multiSelect",
          "group": "3_archive@2"
        },
        {
          "command": "agentSessions.worktree.openFolder",
          "when": "view == agentSessions.worktrees && viewItem =~ /^worktree(-main)?$/ && !agentSessions.phoneMode",
          "group": "inline"
        },
        {
          "command": "agentSessions.worktree.openFolder",
          "when": "view == agentSessions.worktrees && viewItem =~ /^worktree(-main)?$/ && view not in agentSessions.multiSelect",
          "group": "1_open@1"
        },
        {
          "command": "agentSessions.worktree.openTerminal",
          "when": "view == agentSessions.worktrees && viewItem =~ /^worktree(-main)?$/ && view not in agentSessions.multiSelect",
          "group": "1_open@2"
        },
        {
          "command": "agentSessions.worktree.copyPath",
          "when": "view == agentSessions.worktrees && viewItem =~ /^worktree(-main)?$/",
          "group": "1_open@3"
        },
        {
          "command": "agentSessions.worktree.newClaude",
          "when": "view == agentSessions.worktrees && viewItem =~ /^worktree(-main)?$/ && view not in agentSessions.multiSelect",
          "group": "2_new@1"
        },
        {
          "command": "agentSessions.worktree.newCodex",
          "when": "view == agentSessions.worktrees && viewItem =~ /^worktree(-main)?$/ && view not in agentSessions.multiSelect",
          "group": "2_new@2"
        },
        {
          "command": "agentSessions.closeCodex",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session-codex/ && !agentSessions.phoneMode",
          "group": "inline@3"
        },
        {
          "command": "agentSessions.closeCodex",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session-codex/ && view not in agentSessions.multiSelect",
          "group": "1_open@4"
        },
        {
          "command": "agentSessions.pin",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /-pinned-/) && !(viewItem =~ /subagent/) && !agentSessions.phoneMode",
          "group": "inline@4"
        },
        {
          "command": "agentSessions.pin",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /-pinned-/) && !(viewItem =~ /subagent/)",
          "group": "2_pin@1"
        },
        {
          "command": "agentSessions.unpin",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-pinned-/ && !(viewItem =~ /subagent/) && !agentSessions.phoneMode",
          "group": "inline@4"
        },
        {
          "command": "agentSessions.unpin",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-pinned-/ && !(viewItem =~ /subagent/)",
          "group": "2_pin@1"
        },
        {
          "command": "agentSessions.moveToBacklog",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /-backlog-/) && !(viewItem =~ /subagent/)",
          "group": "2_pin@2"
        },
        {
          "command": "agentSessions.removeFromBacklog",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-backlog-/ && !(viewItem =~ /subagent/)",
          "group": "2_pin@2"
        },
        {
          "command": "agentSessions.detach",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-linked$/",
          "group": "2_pin@3"
        },
        {
          "command": "agentSessions.reattach",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-detached$/",
          "group": "2_pin@3"
        },
        {
          "command": "agentSessions.worktree.delete",
          "when": "view == agentSessions.worktrees && viewItem == worktree && !agentSessions.phoneMode",
          "group": "inline@2"
        },
        {
          "command": "agentSessions.worktree.delete",
          "when": "view == agentSessions.worktrees && viewItem == worktree",
          "group": "3_delete@1"
        },
        {
          "command": "agentSessions.copyTranscript",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/",
          "group": "2_copy@2"
        },
        {
          "command": "agentSessions.copyIdentifier",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/",
          "group": "2_copy@3"
        },
        {
          "command": "agentSessions.rename",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /subagent/) && !agentSessions.phoneMode",
          "group": "inline@0"
        },
        {
          "command": "agentSessions.rename",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && !(viewItem =~ /subagent/) && view not in agentSessions.multiSelect",
          "group": "1_open@4"
        },
        {
          "command": "agentSessions.reloadCodexPanel",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session-codex/ && !(viewItem =~ /subagent/) && view not in agentSessions.multiSelect",
          "group": "1_open@5"
        },
        {
          "command": "agentSessions.note.done",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem == note-task-open && !agentSessions.phoneMode",
          "group": "inline@1"
        },
        {
          "command": "agentSessions.note.done",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem == note-task-open",
          "group": "1_note@1"
        },
        {
          "command": "agentSessions.note.markRead",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem == note-answer-answered-unread && !agentSessions.phoneMode",
          "group": "inline@2"
        },
        {
          "command": "agentSessions.note.markRead",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem == note-answer-answered-unread",
          "group": "1_note@1"
        },
        {
          "command": "agentSessions.note.answered",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem == note-question-open && !agentSessions.phoneMode",
          "group": "inline@2"
        },
        {
          "command": "agentSessions.note.answered",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem == note-question-open",
          "group": "1_note@1"
        },
        {
          "command": "agentSessions.note.stale",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-(answer|question)-(open|answered)/",
          "group": "1_note@2"
        },
        {
          "command": "agentSessions.note.reopen",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-task-(done|dropped)$/ && !agentSessions.phoneMode",
          "group": "inline@3"
        },
        {
          "command": "agentSessions.note.reopen",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-(task-done|task-dropped|answer-stale|question-stale)$/",
          "group": "1_note@3"
        },
        {
          "command": "agentSessions.note.remove",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-(task|answer|question)-/ && !agentSessions.phoneMode",
          "group": "inline@4"
        },
        {
          "command": "agentSessions.note.remove",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-(task|answer|question)-/",
          "group": "1_note@4"
        },
        {
          "command": "agentSessions.note.editResolution",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-task-(done|dropped)$/ && !agentSessions.phoneMode",
          "group": "inline@0"
        },
        {
          "command": "agentSessions.note.editResolution",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^note-task-(done|dropped)$/ && view not in agentSessions.multiSelect",
          "group": "1_note@0"
        },
        {
          "command": "agentSessions.rowActions",
          "when": "view =~ /^agentSessions\\.(list|worktrees|current)$/ && viewItem =~ /^(session|worktree|notes?-)/",
          "group": "inline@9"
        },
        {
          "command": "agentSessions.note.viewDone",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-done(-|$)/ && view not in agentSessions.multiSelect",
          "group": "4_done@1"
        },
        {
          "command": "agentSessions.note.editDone",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-done(-|$)/ && view not in agentSessions.multiSelect",
          "group": "4_done@2"
        },
        {
          "command": "agentSessions.note.reopenSession",
          "when": "view =~ /^agentSessions\\.(list|worktrees)$/ && viewItem =~ /^session/ && viewItem =~ /-done(-|$)/",
          "group": "4_done@3"
        },
        {
          "command": "agentSessions.notes.viewAnswers",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-answers(-|$)/ && !agentSessions.phoneMode",
          "group": "inline@1"
        },
        {
          "command": "agentSessions.notes.markAllRead",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-read(-|$)/ && !agentSessions.phoneMode",
          "group": "inline@2"
        },
        {
          "command": "agentSessions.notes.viewAnswers",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-answers(-|$)/ && view not in agentSessions.multiSelect",
          "group": "1_notes@0"
        },
        {
          "command": "agentSessions.notes.doneAll",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-done(-|$)/",
          "group": "1_notes@1"
        },
        {
          "command": "agentSessions.notes.markAllRead",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-read(-|$)/",
          "group": "1_notes@2"
        },
        {
          "command": "agentSessions.notes.answerAll",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-answered(-|$)/",
          "group": "1_notes@3"
        },
        {
          "command": "agentSessions.notes.staleAll",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-stale(-|$)/",
          "group": "1_notes@4"
        },
        {
          "command": "agentSessions.notes.removeClosed",
          "when": "view =~ /^agentSessions\\.(list|current)$/ && viewItem =~ /^notes-.*-closed(-|$)/",
          "group": "1_notes@5"
        }
      ],
      "commandPalette": [
        {

    "configuration": {
      "title": "Agent Sessions",
      "properties": {
        "agentSessions.tools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "default": [
            "claude",
            "codex"
          ],
          "description": "Which tools' sessions to list."
        },
        "agentSessions.groupBy": {
          "type": "string",
          "enum": [
            "activity",
            "repository",
            "tool",
            "none"
          ],
          "enumDescriptions": [
            "Active and pinned sessions first, then the backlog, then history",
            "One group per repository, worktrees inside",
            "Claude and Codex as separate groups",
            "One flat list, newest first"
          ],
          "default": "activity",
          "description": "How the session list is grouped."
        },
        "agentSessions.scope": {
          "type": "string",
          "enum": [
            "all",
            "workspace"
          ],
          "default": "all",
          "description": "Show sessions from every repository, or only those whose working directory belongs to the current workspace's repository (worktrees included)."
        },
        "agentSessions.showArchived": {
          "type": "boolean",
          "default": false,
          "description": "Show sessions archived in Codex or archived from this view."
        },
        "agentSessions.showSubagents": {
          "type": "boolean",
          "default": false,
          "description": "Show every spawned subagent and teammate: nested under its session, or as a row of its own when the parent is not listed. Off: only those working or finished within the last five minutes appear."
        },
        "agentSessions.subagentLayout": {
          "type": "string",
          "enum": [
            "nested",
            "flat",
            "root"
          ],
          "enumDescriptions": [
            "Under its own parent, as a tree: a subagent's subagents under it, expanded",
            "Under the top session's thread, every spawned session at one level",
            "As a row of its own, like any session"
          ],
          "default": "nested",
          "description": "Where spawned subagents, teammates and sessions another agent started are shown."
        },
        "agentSessions.parentSessionMarker": {
          "type": "string",
          "default": "<parent-session>(?<tool>claude|codex):(?<id>[\\w.-]+)</parent-session>",
          "markdownDescription": "A regular expression matched against the start of a session's first prompt (its first 1000 characters). A session whose first prompt matches was started by another agent, and is listed as a subagent of the session the `id` group names — in the tool the optional `tool` group names (`claude` or `codex`), the session's own tool without it. An optional `role` group labels it. A tool that starts sessions for an agent puts the marker in the prompt it sends, e.g. `<parent-session>codex:019a…</parent-session>`; the default pattern recognises that form, and a tag-wrapped marker stays out of the session's title. Empty turns detection off."
        },
        "agentSessions.activeSort": {
          "type": "string",
          "enum": [
            "newest",
            "oldest",
            "activity",
            "attention",
            "title"
          ],
          "enumDescriptions": [
            "The latest started session first; the order holds while agents work",
            "The earliest started session first; new sessions join at the bottom",
            "The session that wrote last first; reorders as agents work",
            "Waiting for input, then replied, then working",
            "Alphabetically by title"
          ],
          "default": "newest",
          "description": "The order of the Active sessions (working or pinned), wherever they are listed. Pinned sessions come first in any order."
        },
        "agentSessions.expandCurrentSession": {
          "type": "boolean",
          "default": false,
          "description": "Open the row of the session in the active agent tab, and keep every other session's row closed: the previous session's row closes when another session becomes current. Off by default: the Current view lists that session's notes."
        },
        "agentSessions.showActiveArchived": {
          "type": "boolean",
          "default": true,
          "description": "List an archived session while it is in use — working, waiting for you, or open in a tab of this window — even when archived sessions are hidden. It keeps its archived look."
        },
        "agentSessions.rowDetails": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "questions",
              "tasks",
              "worktree",
              "edits",
              "age"
            ],
            "enumDescriptions": [
              "Questions the session's agent asked you that wait for you (?), and its answers to yours you have not read (✉)",
              "Tasks done of those recorded (☑ 1/3)",
              "The worktree the session works in",
              "A worktree's commits ahead and behind and its changed lines",
              "How long ago the session was last updated"
            ]
          },
          "default": [
            "questions",
            "tasks",
            "worktree",
            "edits",
            "age"
          ],
          "markdownDescription": "What a session's row shows after its title, in this order. A detail with nothing to show is left out. Tasks, answers and questions are what the session's agent recorded with the `agent-sessions` command (*Agent Sessions: Install the Agent Sessions Plugin for Claude Code and Codex*)."
        },
        "agentSessions.showEmpty": {
          "type": "boolean",
          "default": false,
          "description": "Show stopped sessions where no prompt was ever sent."
        },
        "agentSessions.historyLimit": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "description": "Maximum number of stopped sessions to list."
        },
        "agentSessions.pollInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Seconds between status polls while a session is live. File changes refresh the list immediately regardless."
        },
        "agentSessions.phoneMode": {
          "type": "boolean",
          "default": false,
          "description": "One workbench part at a time, for a phone: the Sessions view fills the window until a session is opened, the session fills it until the Back button. Meant for the window served by `pnpm phone` (code serve-web); leave off in a desktop window."
        },
        "agentSessions.keepSessionsRunning": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Keep panel sessions running when their window closes, the phone sleeps or the VS Code server restarts. Claude Code sessions run under the Agent Sessions session host, which also keeps a session to one window at a time (sets `claudeCode.claudeProcessWrapper`); Codex sessions run in Codex's own app-server daemon, which every window shares (sets `chatgpt.cliExecutable`). Turn it on in every server that opens sessions, the phone server included, and reload windows opened before."
        },
        "agentSessions.idleStopMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "With `#agentSessions.keepSessionsRunning#`: minutes a Claude Code session may sit idle with no window connected before its process is stopped (reopening it resumes it from its transcript). `0` never stops it. A session's process is also what Remote Control reaches, so raise this to keep idle sessions reachable while the laptop is closed; each one holds its memory until then. Applies to sessions opened or reopened after the change."
        },
        "agentSessions.usage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show subscription usage for Claude and Codex."
        },
        "agentSessions.usage.claudeNetwork": {
          "type": "boolean",
          "default": true,
          "description": "Fetch Claude usage from Anthropic's OAuth usage endpoint with the credential Claude Code stores locally (the same call as /usage in the CLI)."
        },
        "agentSessions.usage.codexNetwork": {
          "type": "boolean",
          "default": true,
          "description": "Fetch Codex usage live from chatgpt.com with the login stored in ~/.codex/auth.json (the same request the Codex CLI and plugin make). Expired logins refresh automatically. Off, or when refresh fails, the numbers come from the latest rollout file."
        },
        "agentSessions.usage.refreshInterval": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "description": "Seconds between usage refreshes."
        },
        "agentSessions.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude Code config directory. Empty means $CLAUDE_CONFIG_DIR or ~/.claude."
        },
        "agentSessions.codexHome": {
          "type": "string",
          "default": "",
          "description": "Codex home directory. Empty means $CODEX_HOME or ~/.codex."
        }
      }
    },
    "keybindings": [
      {
        "command": "agentSessions.rename",
        "key": "f2",
        "when": "focusedView == agentSessions.list || focusedView == agentSessions.worktrees"
      },
      {
        "command": "agentSessions.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "focusedView == agentSessions.list || focusedView == agentSessions.worktrees"
      },
      {
        "command": "agentSessions.redo",
        "key": "ctrl+shift+z",
        "win": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "focusedView == agentSessions.list || focusedView == agentSessions.worktrees"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && vsce package --no-dependencies",
    "install-local": "pnpm package && code --install-extension agent-sessions-$npm_package_version.vsix",
    "phone": "node bin/serve-phone.mjs"
  },

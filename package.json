    "@types/ws": "^8.18.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "ws": "8.21.2"
  }
